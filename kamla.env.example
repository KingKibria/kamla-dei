# এই ফাইলের নাম বদলে kamla.env রাখো, তারপর নিজের key বসাও।
# ⚠️ এই ফাইল কাউকে পাঠাবে না — এতে তোমার secret key থাকবে।
#
# ===== Brain: দুটো provider, key-pool সহ (v1.3.0) =====
# সাধারণ কাজ Groq সামলায় (দ্রুত), ভারী ধাপে Xkiro। একটা key limit
# খেলে pool অটো পরের key-তে যায়; পুরো provider ডাউন হলে অন্যটা।
#
# --- Groq (সাধারণ কাজ) — console.groq.com থেকে key নাও ---
# একটা key হলে GROQ_API_KEY, অনেক key হলে কমা দিয়ে GROQ_API_KEYS:
GROQ_API_KEY=<redacted>
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# GROQ_MODEL=openai/gpt-oss-120b
#
# --- Xkiro (ভারী কাজ) ---
KAMLA_API_KEY=<redacted>
# KAMLA_API_KEYS=sk_key1,sk_key2,sk_key3
# ডিফল্ট মডেল: qwen/qwen3.8-max:free (ফ্রি) — বদলাতে চাইলে:
# KAMLA_MODEL=sensenova/sensenova-6.8-flash-lite
# paid balance থাকলে: KAMLA_MODEL=anthropic/claude-sonnet-4.6
#
# কত ধাপ পর কাজ "ভারী" ধরা হবে (ডিফল্ট 3):
# KAMLA_HEAVY_STEP=3
#
# অ্যাডমিন পাসওয়ার্ড বদলাতে (প্রথমবার DB তৈরির আগে):
# KAMLA_ADMIN_PASSWORD=<redacted>
